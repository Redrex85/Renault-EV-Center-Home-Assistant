    "options": {
      "step": {
        "init": {
          "title": "Renault EV Center — Options",
          "description": "Change mapped entities and settings."
        }
      }
    },
    "services": {
      "close_trip": {
        "name": "Close trip now",
        "description": "Force-close the ongoing trip."
      },
      "reset_counters": {
        "name": "Reset counters",
        "description": "Reset the chosen counters.",
        "fields": {
          "scope": {"name": "Scope", "description": "km, energia, costi, viaggi, ricariche or all"}
        }
      },
      "export_trips_csv": {
        "name": "Export trips CSV",
        "description": "Writes trip CSVs to config/renault_ev_center_export."
      },
      "add_manual_charge": {
        "name": "Add manual charge",
        "description": "Log a charge manually (useful for DC chargers).",
        "fields": {
          "kwh": {"name": "kWh charged"},
          "costo": {"name": "Cost €"},
          "tipo": {"name": "Type"},
          "quando": {"name": "Date/time (ISO, optional)"}
        }
      },
      "delete_trip": {
        "name": "Delete trip",
        "description": "Remove a trip from history by ID.",
        "fields": {
          "trip_id": {"name": "Trip ID"}
        }
      },
      "add_maintenance": {
        "name": "Add service record",
        "description": "Log a service/maintenance intervention.",
        "fields": {
          "data": {"name": "Date"},
          "km": {"name": "Odometer km"},
          "costo": {"name": "Cost €"},
          "tipo": {"name": "Type"},
          "note": {"name": "Notes"}
        }
      },
      "delete_maintenance": {
        "name": "Delete service record",
        "description": "Remove a maintenance record by ID.",
        "fields": {
          "maintenance_id": {"name": "Record ID"}
        }
      },
      "renew_insurance": {
        "name": "Renew insurance",
        "description": "Set the new insurance expiry (6/12 months from today or an exact date).",
        "fields": {
          "mesi": {"name": "Months"},
          "data": {"name": "Date"}
        }
      },
      "set_scadenza": {
        "name": "Set deadline",
        "description": "Manually set a deadline (assicurazione, bollo, revisione, tagliando_data).",
        "fields": {
          "nome": {"name": "Name"},
          "data": {"name": "Date"}
        }
      },
      "set_tagliando": {
        "name": "Set next service",
        "description": "Choose whether the next service is due by km or by date.",
        "fields": {
          "mode": {"name": "Mode"},
          "valore": {"name": "Value"}
        }
      },
      "create_dashboard": {
        "name": "Create dashboard",
        "description": "Create/update the sidebar dashboard with all bundled views."
      }
    }
